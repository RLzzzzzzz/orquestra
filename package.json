{
  "name": "orquestra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "memory:install": "node scripts/install-memory.mjs",
    "dev": "node server/index.mjs --dev",
    "build": "vite build",
    "start": "node server/index.mjs",
    "desktop": "node scripts/desktop.mjs",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:pack": "npm run build && npm run desktop:prepare && electron-builder --win --x64 --dir",
    "desktop:portable": "npm run build && npm run desktop:prepare && electron-builder --win portable --x64",
    "desktop:installer": "npm run build && npm run desktop:prepare && electron-builder --win nsis --x64",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "cross-spawn": "^7.0.6",
    "lucide-react": "^0.468.0",
    "node-pty": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@xterm/headless": "^5.5.0",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "vite": "^7.0.0"
  }
}
